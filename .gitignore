# --- Caches et fichiers compilés Python ---
"@ | Set-Content .gitignore
@"
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Environnements virtuels ---
.venv/
venv/
env/
ENV/
.python-version

# --- Distribution / packaging ---
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# --- Tests et couverture ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Secrets et identifiants ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.*
credentials*.json
*.secret

# --- Fichiers temporaires et logs ---
*.log
*.tmp
*.bak
*.swp
*~

# --- IDE / éditeurs ---
.vscode/
.idea/
*.sublime-workspace

# --- Fichiers système ---
.DS_Store
Thumbs.db
desktop.ini

# --- Notebooks ---
.ipynb_checkpoints/
